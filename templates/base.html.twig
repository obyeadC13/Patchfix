<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Patch Fix{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">

    {% block stylesheets %}{% endblock %}
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark pf-navbar">
    <div class="container">
        <a class="navbar-brand pf-brand" href="/">Patch Fix</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div id="mainNavbar" class="collapse navbar-collapse">
            <ul class="navbar-nav me-auto ms-lg-4 gap-lg-2">
                <li class="nav-item">
                    <a class="nav-link" href="/issues">Issues</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#how-it-works">How it works</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#community">Community</a>
                </li>
            </ul>

            <ul class="navbar-nav align-items-lg-center gap-lg-2">
                <li class="nav-item">
                    <a class="nav-link" href="/login">Login</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link pf-nav-cta" href="/issues/new">Report Issue</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main>
    {% block body %}{% endblock %}
</main>

<footer class="pf-footer mt-5">
    <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
        <div>
            <strong>Patch Fix</strong>
            <span class="ms-2">Report problems. Track real fixes.</span>
        </div>
        <div>
            Built for cleaner, safer, more responsive communities.
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>